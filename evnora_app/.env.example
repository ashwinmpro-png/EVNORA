# Evnora App Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
API_BASE_URL=https://api.evnora.com/v1

# Razorpay Configuration
RAZORPAY_KEY=rzp_test_your_key_here
RAZORPAY_SECRET=your_secret_here

# LinkedIn OAuth Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URL=https://your-app.com/auth/linkedin/callback

# Firebase Configuration (handled by google-services.json and GoogleService-Info.plist)
# No additional configuration needed here

# Optional: Analytics
# MIXPANEL_TOKEN=your_mixpanel_token
# AMPLITUDE_API_KEY=your_amplitude_key
